# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# `make check-env` checks what you wrote here, and it needs nothing running —
# no container, no database, no network. It reports two different mistakes:
#
#   a value that will NOT LOAD    the API cannot start at all. It builds its app
#                                 at import, so the container exits and restarts
#                                 and the dashboard's sign-in screen says
#                                 "Cannot reach the API."  Loud, and findable.
#
#   a key that NOTHING READS      a misspelling. This is the dangerous one. The
#                                 file is shared with compose and Vite, so
#                                 `Settings` ignores anything it does not
#                                 recognise rather than refusing to start —
#                                 which means `DASHBOARD_STALE_AFTER_SECOND=60`
#                                 (no S) loads perfectly, does nothing, and
#                                 leaves the threshold at its 300 default. Five
#                                 times more tolerant of a stale reading than
#                                 you just told it to be, with nothing on screen
#                                 and nothing in any log.
#
# Run it after editing this file, and before `make up-prod` or a paper week.

# ─── run mode ────────────────────────────────────────────────────────────────
# backtest | paper | live
# `paper` routes to Alpaca's paper endpoint: live market data, simulated money.
#
# Defaults to `backtest`, the only mode that needs no credentials: `make up`
# copies this file verbatim, and a fresh clone has no Alpaca keys to give it.
# Move to `paper` once ALPACA_API_KEY and ALPACA_API_SECRET are filled in.
#
# Moving first and filling them in after is fine: the API and worker still
# start, the dashboard still serves, and startup says `no_broker_credentials` at
# CRITICAL. Nothing can place an order until the pair is set — `AlpacaBroker`
# refuses to build without it and the worker reports a blocked intention rather
# than trading. This used to be fatal: `Settings` would not validate, so the API
# could not import, and the only symptom was the dashboard reporting that it
# could not reach an API that was crash-looping.
ATP_RUN_MODE=backtest

# Second lock on live trading. Even with ATP_RUN_MODE=live, orders are refused
# unless this is exactly "true". Keep it false until you have read docs/SAFETY.md.
ATP_ALLOW_LIVE_TRADING=false

ATP_ENV=development          # development | staging | production
ATP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
ATP_LOG_FORMAT=console       # console | json  (use json in production)

# ─── broker: Alpaca ──────────────────────────────────────────────────────────
# Paper and live are SEPARATE key pairs. Get them at https://app.alpaca.markets
#
# These two stay EMPTY in this file. It is tracked, so a key pasted here is a
# key published — and a broker key, once pushed, cannot be un-pushed by a
# follow-up commit; it has to be revoked at Alpaca. Put real values in `.env`,
# which is gitignored and is what `atp_core.config.Settings` actually reads.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Base URLs carry no version segment — the adapter's own paths supply `/v2`
# (see `brokers/alpaca.py`), so a `/v2` suffix here would request `/v2/v2/...`.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
# iex = free real-time. sip = full consolidated tape, paid subscription.
ALPACA_DATA_FEED=iex

# ─── datastores ──────────────────────────────────────────────────────────────
# The database password the DEPLOYED stack runs on, and the first thing
# `make deploy` checks. It is read by DOCKER COMPOSE, not by `Settings` —
# docker-compose.prod.yml interpolates it into `POSTGRES_PASSWORD` and into the
# three `DATABASE_URL`s it hands the api, worker and queue containers. That is
# why `make check-env` does not report it as unread (`READ_ELSEWHERE` in
# scripts/check_env.py) and why nothing in `libs/` mentions it.
#
# EMPTY IS FINE UNTIL YOU DEPLOY. `make up` and `make up-prod` run the base
# compose file, which hardcodes `atp`/`atp` — right for a laptop on loopback,
# and the reason this line exists at all. `make deploy` applies the overlay,
# where the same default would be a host running on a password published in a
# public repository, so the overlay uses `:?` and fails the command instead:
#
#     ATP_DB_PASSWORD: set ATP_DB_PASSWORD in .env - the base file default is
#     the development password
#
# That message used to arrive at deploy time naming a variable this template
# never mentioned, which is a bad moment to meet it. Generate one with:
#
#     openssl rand -hex 24
#
# USE THAT, not a passphrase from a manager. This value is copied down two paths
# that must agree and neither is a plain copy: compose interpolates it into
# POSTGRES_PASSWORD, which initdb stores verbatim, and into a DATABASE_URL that
# SQLAlchemy parses as a URL. Three characters do not survive both — `%` before
# two hex digits is a percent-escape and is DECODED, `@` ends the credentials,
# `$` is a variable reference to compose. Any of them and the deployed stack
# authenticates with a different string from the one initdb stored: the API
# starts fine and then fails every request that reads the database. Hex has none
# of them. `make check-env` refuses the ones that do not survive, before deploy
# rather than after (docs/RUNBOOK.md, "password authentication failed").
#
# POSTGRES READS IT AT INITDB AND NEVER AGAIN. Set it BEFORE the first
# `make deploy`; the volume keeps whatever password it was created with. Setting
# it afterwards needs `ALTER USER atp PASSWORD ...` inside the running container
# AND this value updated to match, or the stack comes up unable to authenticate
# to its own database. docs/DEPLOYMENT.md has both procedures.
#
# Nothing in this file can show you that you got that wrong — a rotated password
# leaves it correct and internally consistent, and the database refusing it. So
# `make check-env` asks the database itself once the file checks out, and says
# so. That is the one check in it that needs the stack up; run it after a
# rotation, not only before a deploy.
#
# It belongs in the SOPS bundle with the other secrets, not in a commit.
ATP_DB_PASSWORD=

# Host-side tools — `make migrate`, `seed`, `backfill`, `status`, `preflight` —
# read THIS url, not the one compose builds. `atp:atp` matches the base file, so
# it is correct for `make up` and `make up-prod` as written. On a deployed stack
# it must carry the ATP_DB_PASSWORD you set above, or migrations fail against the
# database the containers are happily using.
#
# `make migrate` was the one tool in that list this was not true of. Alembic read
# the process environment rather than this file and fell back to `atp:atp`, so a
# host whose password was anything else failed the first command in the runbook
# with `password authentication failed for user "atp"` — naming a password the
# operator had never written. It reads this line now, and says so when the
# database refuses it. `scripts/halt.py` was named here and never belonged: it
# reads REDIS_URL and never opens Postgres, which is exactly why the runbook can
# promise it still works while this fault is happening.
DATABASE_URL=postgresql+asyncpg://atp:atp@localhost:5432/atp
REDIS_URL=redis://localhost:6379/0

# ─── risk limits ─────────────────────────────────────────────────────────────
# **The eight `RISK_*` values are not here any more.** The position, exposure and
# daily-loss ceilings, the order-rate, open-position and quote-age budgets and
# the two stop/target fallbacks are edited on the dashboard's **Config** tab, in
# the risk section under the worker settings, and stored in the `worker_config`
# row beside them.
#
# They moved for the reason the ten `WORKER_*` values above them moved: changing
# one needed shell access to this host, nothing recorded who did it, and the API
# could not read them to explain a refusal it had just returned. A position
# limit is also tuned against a book, and this file is the one place a book
# cannot be seen from.
#
# If you had tuned any of them, copy the values onto that tab once — the
# migration cannot read this file, so it backfills the defaults below, which are
# the values this file used to ship:
#
#   max position 0.10 · gross exposure 1.00 · daily loss 0.03
#   orders/minute 30 · open positions 20 · quote age 30s
#   default stop loss 0.02 · default take profit 0.06
#
# A leftover `RISK_*` line here is read by nothing. `make check-env` says so.

# ─── engine ──────────────────────────────────────────────────────────────────
ENGINE_TICK_INTERVAL_SECONDS=60     # strategy evaluation cadence
DASHBOARD_STALE_AFTER_SECONDS=300   # requirement #7: warn past this age (no auto-refresh)

# ─── alerting ────────────────────────────────────────────────────────────────
# docs/SAFETY.md's go-live checklist: "alerts reach a human on a phone, not just
# a log file". Every automated halt — a lost feed, a reconciliation mismatch, a
# worker task dying — goes out through here, plus manual halts and resumes.
#
# Opt-in. With no topic set the platform logs what it would have sent and starts
# normally: a notification must not be a dependency of trading.
#
# THE TOPIC IS A CREDENTIAL, not a name. On the public ntfy.sh server it is the
# only thing standing between your halt notifications and anyone who guesses it,
# in both directions — reading them and forging them. Generate a long random one
#     python -c "import uuid; print('atp-' + uuid.uuid4().hex)"
# and keep it in the SOPS bundle with the other secrets (docs/DEPLOYMENT.md).
# Better still, self-host ntfy and set a token; then it is not a guess away.
ALERT_NTFY_BASE_URL=https://ntfy.sh
ALERT_NTFY_TOPIC=
ALERT_NTFY_TOKEN=
# Telegram, as an alternative or an addition. Set both of these and alerts go to
# the operator's own chat with a bot; set these AND a topic above and both are
# sent, because two configured transports is a request for two — one push
# service having a bad day should not be the same as having no alerting.
#
# THE BOT TOKEN IS THE BOT. It travels in the URL path, and anyone holding it
# can read the chat and post to it as you. Bundle it, never commit it. Setup:
#   1. message @BotFather, /newbot, keep the token
#   2. message your new bot once — a bot cannot open a conversation, so without
#      this it has nowhere to deliver
#   3. curl https://api.telegram.org/bot<TOKEN>/getUpdates  → result[].message.chat.id
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_BASE_URL=https://api.telegram.org
# Short on purpose: this runs after the halt is already durable, so a longer
# timeout only makes the call that stopped trading take longer to return.
ALERT_TIMEOUT_SECONDS=5

# ─── metrics and tracing ─────────────────────────────────────────────────────
# docs/OBSERVABILITY.md, ADR 0013. Prometheus text exposition on /metrics, from
# the API and from the worker separately — a dead worker must be a failed scrape
# rather than gauges frozen at their last healthy values.
#
# THE SCRAPE IS A CREDENTIAL. The body carries no balance and no P&L, but it
# does carry the watchlist, the order flow and the hours this platform is busy.
# Unset means NOTHING CAN SCRAPE: the API still answers a signed-in operator,
# the worker answers nobody, and both say so at startup.
#
# Long and random — it is compared against a header at HTTP speed, and the rate
# limiter that sits in front of sign-in does not sit in front of this:
#   openssl rand -hex 32
# It belongs in the SOPS bundle (docs/DEPLOYMENT.md), not in a commit.
METRICS_TOKEN=
# The worker's own listener. Container-internal and deliberately NOT published
# to the host — reachable across the compose network like Postgres and Redis.
# `make check-bindings` is what keeps it that way.
WORKER_METRICS_PORT=9101
WORKER_METRICS_ADDR=0.0.0.0

# ─── worker ──────────────────────────────────────────────────────────────────
# THE WORKER'S TRADING PARAMETERS ARE NOT IN THIS FILE ANY MORE.
#
# The watchlist, the strategy and its parameters, how orders are sized, the
# protective stop, the feed watchdog and the live-orders lock live in the
# database, and the dashboard's **Worker** tab is where they are edited. Ten
# keys were removed from here: WORKER_SYMBOLS, WORKER_MAX_SILENCE_SECONDS,
# WORKER_STRATEGY, WORKER_STRATEGY_PARAMS, WORKER_SIZING_METHOD,
# WORKER_SIZING_VALUE, WORKER_STOP_TYPE, WORKER_STOP_MULTIPLIER,
# WORKER_STOP_PERIOD and WORKER_ALLOW_LIVE_ORDERS.
#
# They were the only settings in this file that an operator changed while the
# platform was *running*, and that made them the wrong shape for it: changing
# one needed shell access to the host, nothing recorded who changed it or when,
# and the API could not read them — so every screen that wanted to explain why
# nothing was trading had to say "go and look at a file".
#
# Nothing is defaulted into the database by the migration, so a fresh install
# still trades nothing until somebody opens that tab and says what to trade —
# the same posture an empty WORKER_STRATEGY always had, for the same reason.
#
# IF YOU STILL HAVE THEM HERE, they are being ignored. `Settings` skips keys it
# does not recognise (see the header), so nothing will fail; `make check-env`
# lists them as keys nothing reads. Copy the values into the Worker tab, then
# delete the lines.
#
# WORKER_ALLOW_LIVE_ORDERS specifically: it is still the third lock and still
# separate from ATP_RUN_MODE and ATP_ALLOW_LIVE_TRADING, which stay here. What
# changed is where it is armed — the dashboard asks for your account password
# to turn it on, and asks for nothing to turn it off.
#
# Only the metrics listener stayed, above, with the rest of the metrics block:
# an address is what the process *is*, fixed by its container, and changing it
# is a deploy rather than a decision about trading.

# ─── api / web ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Only consulted when the dashboard is served from a DIFFERENT origin than the
# API. It is not, in either supported setup: the dev server proxies /api and
# /ws (vite.config.ts) and nginx does the same in production
# (infra/docker/web.nginx.conf), so the browser sees one origin and never
# sends a cross-origin request. Left here for a bundle deliberately built
# against a remote API — see VITE_API_BASE_URL below.
API_CORS_ORIGINS=http://localhost:5173

# ─── sign-in (ADR 0008) ──────────────────────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -hex 32
#
# Leaving it empty does NOT disable authentication — the API mints a random key
# at startup instead and logs a warning, which means sessions stop working every
# time the process restarts. Set it for anything you intend to leave running.
API_SECRET_KEY=

# The single operator. There is no users table and deliberately none: this
# platform is run by one person (ADR 0008).
API_USER=operator

# The bcrypt hash of that account's password — never the password itself.
# Produce the line with:
#
#     uv run python scripts/hash_password.py
#
# That needs the workspace installed — `make install`. After a plain `uv sync`
# the hashing code's dependencies are absent and the script says so and how to
# fix it; `uv run --package atp-api python scripts/hash_password.py` works
# either way.
#
# PASTE IT WITH THE SINGLE QUOTES THE SCRIPT PRINTS:
#
#     API_PASSWORD_HASH='$2b$12$X4h...'
#
# A bcrypt hash is `$2b$12$<salt><digest>`, and Docker Compose interpolates
# `$NAME` in this file. Unquoted, the `$` and the salt's leading letters are
# read as a variable nobody set — compose says
#
#     WARN[0000] The "hnn" variable is not set. Defaulting to a blank string.
#
# with whatever your salt starts with in place of `hnn` — and substitutes a
# blank string, so the API gets a hash with a bite taken out of it. Non-empty,
# so the "unset" warning below does not fire; not a hash, so every login is
# refused. Four hashes in five have a salt starting with a letter and hit this.
#
# Single quotes, not `$$`: this file is also read by `Settings` through
# pydantic-settings, which does not interpolate and would keep the doubled `$`s
# verbatim. Quotes are stripped by both readers; `$$` is understood by only one.
#
# EMPTY MEANS NOBODY CAN LOG IN, not that anyone can. The API logs CRITICAL at
# startup to say so. That is the safe half of the failure and it is deliberate.
# A truncated one is CRITICAL too (`startup.malformed_credentials`).
API_PASSWORD_HASH=

# How long a sign-in lasts. Sessions cannot be revoked before this elapses —
# nothing keeps a denylist — so this is also how long a stolen cookie is good
# for. Short enough to matter, long enough that it does not demand a re-login
# in the middle of a trading session.
API_SESSION_HOURS=12

# How many sign-in attempts one client address may make per window before the
# endpoint stops trying. Counted per ADDRESS, not per username: counting per
# username would let anyone who knows the operator's name lock them out of their
# own platform by failing to log in as them.
#
# Attempts, not failures — a correct password is refused too once the limit is
# reached, because otherwise the guess that happens to be right is the one that
# gets through. If Redis is unreachable the limiter allows and says so loudly:
# locking the operator out during an outage is the worse failure (ADR 0010).
API_LOGIN_ATTEMPTS=10
API_LOGIN_WINDOW_SECONDS=300

# ─── dashboard ───────────────────────────────────────────────────────────────
#
# EVERY key in this section is deliberately NOT an `atp_core.config.Settings`
# field. They are read before or outside any Python process — Vite inlines the
# VITE_* pair into the bundle at build time, the dev server reads its own proxy
# target, and compose interpolates the bind address into a published port.
#
# `make check-env` knows that (`READ_ELSEWHERE` in scripts/check_env.py) and
# does not report them as unread. If you add a key here, add it there too with
# what reads it — and if a key ever moves the other way, into `Settings`, take
# it out of that list. A `Settings` field sitting in it is a field the platform
# silently stopped reading, which is exactly what the check exists to catch.
# BOTH ARE BUILD-TIME, NOT RUNTIME. Vite inlines `import.meta.env.VITE_*` into
# the bundle when it is built, so setting either of these on a container that
# is *serving* a built bundle changes nothing at all — the value compiled in
# months ago is the one the browser uses. They reach a build through the
# Dockerfile's build args (infra/docker/web.Dockerfile), not through here.
#
# Leave them EMPTY, which is what "same origin as the page" means and what
# makes one build correct on localhost, on a LAN address and behind a
# hostname. Set them only to point the dashboard at an API on another origin,
# which also means listing that origin in API_CORS_ORIGINS above and giving up
# a bundle that travels.
VITE_API_BASE_URL=
VITE_WS_URL=

# Where `npm run dev` forwards /api and /ws. Dev-server only — it is not
# VITE_-prefixed on purpose, so it never reaches the browser bundle. Compose
# overrides it to http://api:8000, because inside the web container
# `localhost` is the web container.
ATP_DEV_PROXY_TARGET=http://localhost:8000

# Which host address `make up-prod` publishes the dashboard on. THE ONLY PORT
# IN THIS STACK THAT IS MEANT TO BE REACHABLE FROM ANOTHER MACHINE — db, redis,
# the API and the dev server are all pinned to 127.0.0.1 in docker-compose.yml
# and are not configurable, because nothing outside this host has any business
# reaching an unauthenticated API or a passwordless Redis holding the
# kill-switch state.
#
#   (empty)        127.0.0.1 — this host only. The default, and fail-closed.
#   192.168.1.50   a LAN interface. Find yours with: ip -4 -brief addr
#   100.71.4.19    a Tailscale interface (tailscale ip -4)
#   10.8.0.1       a WireGuard interface
#
# It must be a PRIVATE address. Two values are refused by `make check-bindings`,
# and the second is the one people actually reach for: 0.0.0.0, and any publicly
# routable address. If you searched "what is my IP" to find a value for this,
# what you got is the address your ROUTER shows the internet — not your
# machine's — and putting it here asks Docker to serve the trading book to
# anyone who cares to connect. Your machine's address is the one from
# `ip -4 -brief addr` (192.168.x, 10.x) or `tailscale ip -4` (100.x).
#
# Signing in is required (ADR 0008), so this value is no longer the whole
# access-control story — but it is the outer half of it, and the half that has
# to hold while the inner one is a single password sent over plain HTTP. Do not
# reach for a firewall instead: on Linux, Docker publishes ports by rules that
# bypass ufw entirely, so `ufw deny 8080` reports itself applied and blocks
# nothing at all.
ATP_WEB_BIND_ADDR=
