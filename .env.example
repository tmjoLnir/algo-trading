# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ─── run mode ────────────────────────────────────────────────────────────────
# backtest | paper | live
# `paper` routes to Alpaca's paper endpoint: live market data, simulated money.
#
# Defaults to `backtest`, the only mode that needs no credentials: `make up`
# copies this file verbatim, and a fresh clone has no Alpaca keys to give it.
# Move to `paper` once ALPACA_API_KEY and ALPACA_API_SECRET are filled in.
ATP_RUN_MODE=backtest

# Second lock on live trading. Even with ATP_RUN_MODE=live, orders are refused
# unless this is exactly "true". Keep it false until you have read docs/SAFETY.md.
ATP_ALLOW_LIVE_TRADING=false

ATP_ENV=development          # development | staging | production
ATP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
ATP_LOG_FORMAT=console       # console | json  (use json in production)

# ─── broker: Alpaca ──────────────────────────────────────────────────────────
# Paper and live are SEPARATE key pairs. Get them at https://app.alpaca.markets
#
# These two stay EMPTY in this file. It is tracked, so a key pasted here is a
# key published — and a broker key, once pushed, cannot be un-pushed by a
# follow-up commit; it has to be revoked at Alpaca. Put real values in `.env`,
# which is gitignored and is what `atp_core.config.Settings` actually reads.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Base URLs carry no version segment — the adapter's own paths supply `/v2`
# (see `brokers/alpaca.py`), so a `/v2` suffix here would request `/v2/v2/...`.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
# iex = free real-time. sip = full consolidated tape, paid subscription.
ALPACA_DATA_FEED=iex

# ─── datastores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://atp:atp@localhost:5432/atp
REDIS_URL=redis://localhost:6379/0

# ─── risk limits (hard ceilings; per-strategy limits may be tighter) ─────────
RISK_MAX_POSITION_PCT=0.10          # max 10% of equity in one symbol
RISK_MAX_GROSS_EXPOSURE_PCT=1.00    # no leverage by default
RISK_MAX_DAILY_LOSS_PCT=0.03        # halt all trading after -3% on the day
RISK_MAX_ORDERS_PER_MINUTE=30       # runaway-loop protection
RISK_MAX_OPEN_POSITIONS=20          # unmonitorable sprawl
RISK_MAX_QUOTE_AGE_SECONDS=30       # refuse to trade on a feed this stale
RISK_DEFAULT_STOP_LOSS_PCT=0.02     # fallback only — ATR stops are the default
RISK_DEFAULT_TAKE_PROFIT_PCT=0.06

# ─── engine ──────────────────────────────────────────────────────────────────
ENGINE_TICK_INTERVAL_SECONDS=60     # strategy evaluation cadence
DASHBOARD_REFRESH_SECONDS=300       # requirement #7: 5-minute auto-refresh

# ─── worker ──────────────────────────────────────────────────────────────────
# The market-data watchlist, comma-separated. Empty by default: a worker that
# invented a universe would spend the one Alpaca stream connection on symbols
# nobody chose. With this empty the worker still runs its schedule, and says at
# startup that it is ingesting nothing.
WORKER_SYMBOLS=
# How long the feed may go quiet *during a session* before the watchdog halts
# trading. Looser than RISK_MAX_QUOTE_AGE_SECONDS above on purpose: that one is
# how stale a quote may be when an order is priced against it, this one is how
# long a connection may deliver nothing at all.
WORKER_MAX_SILENCE_SECONDS=60

# The strategy this worker trades, by registry name. EMPTY MEANS IT PLACES NO
# ORDERS — the worker still ingests and runs its schedule, and says which at
# startup. Naming one here is the whole opt-in for paper.
WORKER_STRATEGY=
# Strategy parameters as JSON, e.g. {"fast_period": 20, "slow_period": 50}.
# Empty uses the strategy's own defaults. Malformed JSON is refused at startup
# rather than falling back, because running on defaults an operator does not
# think are in force is the quietest way to trade the wrong thing.
WORKER_STRATEGY_PARAMS=
# How orders are sized. risk_pct at 0.01 is docs/RISK.md's default pair: size
# so that hitting the stop loses 1% of equity, which keeps risk per trade
# constant across instruments of wildly different volatility.
WORKER_SIZING_METHOD=risk_pct
WORKER_SIZING_VALUE=0.01
# The protective stop armed on every entry. ATR at 2x is preferred over a fixed
# percentage, which is too tight on a volatile name and too loose on a dull one.
WORKER_STOP_TYPE=atr
WORKER_STOP_MULTIPLIER=2
WORKER_STOP_PERIOD=14
# The THIRD lock, and it applies to live only. ATP_RUN_MODE=live and
# ATP_ALLOW_LIVE_TRADING=true between them say this process may trade real
# money; this says this unattended loop may place the orders. Different
# decisions, and deliberately not the same switch. Paper ignores it.
WORKER_ALLOW_LIVE_ORDERS=false

# ─── api / web ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Only consulted when the dashboard is served from a DIFFERENT origin than the
# API. It is not, in either supported setup: the dev server proxies /api and
# /ws (vite.config.ts) and nginx does the same in production
# (infra/docker/web.nginx.conf), so the browser sees one origin and never
# sends a cross-origin request. Left here for a bundle deliberately built
# against a remote API — see VITE_API_BASE_URL below.
API_CORS_ORIGINS=http://localhost:5173

# ─── sign-in (ADR 0008) ──────────────────────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -hex 32
#
# Leaving it empty does NOT disable authentication — the API mints a random key
# at startup instead and logs a warning, which means sessions stop working every
# time the process restarts. Set it for anything you intend to leave running.
API_SECRET_KEY=

# The single operator. There is no users table and deliberately none: this
# platform is run by one person (ADR 0008).
API_USER=operator

# The bcrypt hash of that account's password — never the password itself.
# Produce the line with:
#
#     uv run python scripts/hash_password.py
#
# EMPTY MEANS NOBODY CAN LOG IN, not that anyone can. The API logs CRITICAL at
# startup to say so. That is the safe half of the failure and it is deliberate.
API_PASSWORD_HASH=

# How long a sign-in lasts. Sessions cannot be revoked before this elapses —
# nothing keeps a denylist — so this is also how long a stolen cookie is good
# for. Short enough to matter, long enough that it does not demand a re-login
# in the middle of a trading session.
API_SESSION_HOURS=12

# How many sign-in attempts one client address may make per window before the
# endpoint stops trying. Counted per ADDRESS, not per username: counting per
# username would let anyone who knows the operator's name lock them out of their
# own platform by failing to log in as them.
#
# Attempts, not failures — a correct password is refused too once the limit is
# reached, because otherwise the guess that happens to be right is the one that
# gets through. If Redis is unreachable the limiter allows and says so loudly:
# locking the operator out during an outage is the worse failure (ADR 0010).
API_LOGIN_ATTEMPTS=10
API_LOGIN_WINDOW_SECONDS=300

# ─── dashboard ───────────────────────────────────────────────────────────────
# BOTH ARE BUILD-TIME, NOT RUNTIME. Vite inlines `import.meta.env.VITE_*` into
# the bundle when it is built, so setting either of these on a container that
# is *serving* a built bundle changes nothing at all — the value compiled in
# months ago is the one the browser uses. They reach a build through the
# Dockerfile's build args (infra/docker/web.Dockerfile), not through here.
#
# Leave them EMPTY, which is what "same origin as the page" means and what
# makes one build correct on localhost, on a LAN address and behind a
# hostname. Set them only to point the dashboard at an API on another origin,
# which also means listing that origin in API_CORS_ORIGINS above and giving up
# a bundle that travels.
VITE_API_BASE_URL=
VITE_WS_URL=

# Where `npm run dev` forwards /api and /ws. Dev-server only — it is not
# VITE_-prefixed on purpose, so it never reaches the browser bundle. Compose
# overrides it to http://api:8000, because inside the web container
# `localhost` is the web container.
ATP_DEV_PROXY_TARGET=http://localhost:8000

# Which host address `make up-prod` publishes the dashboard on. THE ONLY PORT
# IN THIS STACK THAT IS MEANT TO BE REACHABLE FROM ANOTHER MACHINE — db, redis,
# the API and the dev server are all pinned to 127.0.0.1 in docker-compose.yml
# and are not configurable, because nothing outside this host has any business
# reaching an unauthenticated API or a passwordless Redis holding the
# kill-switch state.
#
#   (empty)        127.0.0.1 — this host only. The default, and fail-closed.
#   192.168.1.50   a LAN interface. Find yours with: ip -4 -brief addr
#   100.71.4.19    a Tailscale interface (tailscale ip -4)
#   10.8.0.1       a WireGuard interface
#
# It must be a PRIVATE address. Two values are refused by `make check-bindings`,
# and the second is the one people actually reach for: 0.0.0.0, and any publicly
# routable address. If you searched "what is my IP" to find a value for this,
# what you got is the address your ROUTER shows the internet — not your
# machine's — and putting it here asks Docker to serve the trading book to
# anyone who cares to connect. Your machine's address is the one from
# `ip -4 -brief addr` (192.168.x, 10.x) or `tailscale ip -4` (100.x).
#
# There is no authentication (docs/SAFETY.md), so this one value is the whole
# access-control story. Do not reach for a firewall instead: Docker publishes
# ports by rules that bypass ufw entirely, so `ufw deny 8080` reports itself
# applied and blocks nothing.
ATP_WEB_BIND_ADDR=
