# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# The one deliberate exception, and it is not one: a SOPS bundle is ciphertext
# and IS committed — that is the whole design (ADR 0011, scripts/manage_secrets.py).
# Everything else that turns up in infra/env/ is plaintext, whether from a
# careless `sops -d > file` or a half-finished import, so the directory is
# ignored except for the bundles themselves.
#
# Anchored with a leading slash, per the lesson spelled out in the data/ block
# below. Note also why the bundles do not live in `secrets/`: that rule is
# unanchored, so it matches at every depth, and git cannot re-include a file
# whose parent directory is excluded — a bundle under it could not be rescued
# by any negation. `make check-tracked` covers this path so a future edit that
# swallows a bundle fails the build instead of producing a host with no
# credentials.
/infra/env/*
!/infra/env/*.sops.env

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- node ---
# The intermediate file `make gen-types` dumps the API schema to before it
# generates `src/api/schema.d.ts`. The generated types ARE committed — CI
# type-checks against them — but this is a build input, reproducible in one command.
apps/web/openapi.json
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo
npm-debug.log*

# --- data & artifacts ---
# ANCHOR THESE WITH A LEADING SLASH. An unanchored `data/` matches at every
# depth, and this repo has a source package at libs/core/src/atp_core/data/ —
# the entire market-data layer was silently excluded from the repository until
# CI, which only ever sees committed files, failed to import it. A leading
# slash restricts the rule to the repo root, where the artifacts actually live.
# Market data is large and reproducible via backfill; do not version it.
/data/
*.parquet
*.duckdb
*.sqlite3
/backtest_results/
/reports/out/
/logs/
*.log

# --- editors / os ---
.vscode/
.idea/
.DS_Store
