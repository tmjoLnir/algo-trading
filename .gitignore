# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- node ---
# The intermediate file `make gen-types` dumps the API schema to before it
# generates `src/api/schema.d.ts`. The generated types ARE committed — CI
# type-checks against them — but this is a build input, reproducible in one command.
apps/web/openapi.json
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo
npm-debug.log*

# --- data & artifacts ---
# ANCHOR THESE WITH A LEADING SLASH. An unanchored `data/` matches at every
# depth, and this repo has a source package at libs/core/src/atp_core/data/ —
# the entire market-data layer was silently excluded from the repository until
# CI, which only ever sees committed files, failed to import it. A leading
# slash restricts the rule to the repo root, where the artifacts actually live.
# Market data is large and reproducible via backfill; do not version it.
/data/
*.parquet
*.duckdb
*.sqlite3
/backtest_results/
/reports/out/
/logs/
*.log

# --- editors / os ---
.vscode/
.idea/
.DS_Store
